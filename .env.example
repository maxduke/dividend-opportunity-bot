TELEGRAM_TOKEN=
ADMIN_USER_ID=
DB_FILE=/app/data/rules.db

CHECK_INTERVAL_SECONDS=60
ENABLE_INTRADAY_MONITOR=false
RSI_PERIOD=6
TECHNICAL_HISTORY_DAYS=550
FETCH_FAILURE_THRESHOLD=5
REQUEST_INTERVAL_SECONDS=1.0
FETCH_RETRY_ATTEMPTS=3
FETCH_RETRY_DELAY_SECONDS=5

DAILY_BRIEFING_TIMES=14:50
VALUATION_CACHE_HOURS=12
BOND_CACHE_HOURS=12
VALUATION_STALE_MAX_TRADING_DAYS=3
VALUATION_PERCENTILE_MIN_OBS=252
VALUATION_PERCENTILE_MIN_SPAN_YEARS=2.0
VALUATION_PERCENTILE_LOOKBACK_YEARS=5
CSI_DIVIDEND_YIELD_FIELD=股息率2
OPPORTUNITY_ALERT_THRESHOLD=60
MIN_VALUATION_SCORE_FOR_OPPORTUNITY=20
OPPORTUNITY_ALERT_COOLDOWN_MINUTES=240
OPPORTUNITY_MAX_ALERTS_PER_DAY=1
AKSHARE_CALL_TIMEOUT_SECONDS=15
AKSHARE_PROXY_CALL_TIMEOUT_SECONDS=300
HISTORY_FAILURE_COOLDOWN_MINUTES=30

# Optional: route selected EastMoney requests through akshare-proxy-patch.
# Keep disabled unless you have a valid provider token; never commit the token.
ENABLE_AKSHARE_PROXY_PATCH=false
AKSHARE_PROXY_AUTH_IP=101.201.173.125
AKSHARE_PROXY_AUTH_TOKEN=
AKSHARE_PROXY_RETRY=30
AKSHARE_PROXY_HOOK_DOMAINS=push2.eastmoney.com,push2his.eastmoney.com
# proxy 模式下新浪历史数据足够时不会请求 EastMoney；失败历史会冷却，避免重复计费调用。
